# Shopify Storefront API & Shop Pay button integration
#
# Local development:
#   cp .env.example .env.local
#   .env.local に実値を記入 (.gitignore で git 除外済み)
#
# Production (GitHub Actions):
#   Settings → Secrets and variables → Actions に同名で登録

# Shopify ストアドメイン (スキームなし、cartCreate と shop-pay-button で共通使用)
# 例: mirror-mirror.myshopify.com
VITE_SHOPIFY_DOMAIN=

# Storefront API public access token
# 取得方法: Shopify Admin → Settings → Apps → Develop apps → カスタムアプリ作成 → Storefront API
# 必要 scope: unauthenticated_read_product_listings, unauthenticated_write_checkouts,
#             unauthenticated_read_checkouts
VITE_SHOPIFY_STOREFRONT_TOKEN=

# 特装版 variant の数値 ID (gid プレフィックスなし)
# 取得方法: Shopify Admin → Products → 該当商品 → Variants → URL 末尾の数値
# 例: 12345678901234
VITE_SHOPIFY_VARIANT_ID=
